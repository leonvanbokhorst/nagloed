    "grain.reverse": 0.3,
    "grain.jitter": 0.5,
    "grain.shape": 0.5,
    "grain.width": 0.7,
    "grain.feedback": 0.55,
    "grain.focus": 0.45,
    "grain.freeze": 0,
    "grain.tune": 2,
    "grain.source": 2,
    "space.mix": 0.6,
    "space.size": 0.75,
    "space.damp": 0.35,
    "space.mod": 0.4,
    "ear.drive": 8,
    "ear.bias": 0.3,
    "ear.tone": 0.35,
    "ear.cutoff": 2500,
    "ear.reso": 0.3,
